{
  "name": "erp-associacoes",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de Gestão Integrada da Associação Exemplo",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10"
  },
  "scripts": {
    "dev": "node scripts/copiar-ocr.mjs && vite",
    "dev:demo": "node scripts/copiar-ocr.mjs && vite --mode demo",
    "build": "node scripts/copiar-ocr.mjs && tsc -b && vite build",
    "build:demo": "node scripts/copiar-ocr.mjs && tsc -b && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "segredos": "secretlint \"**/*\"",
    "verificar-build": "node scripts/verificar-build.mjs dist",
    "verificar": "npm run typecheck && npm run test:all && npm run build && npm run verificar-build && npm run segredos",
    "politica": "node --experimental-strip-types -e \"import('./src/telas/privacidade/texto.ts').then(m => require('node:fs').writeFileSync('docs/politica-privacidade.md', m.politicaEmMarkdown()))\"",
    "demo:celular": "node scripts/demo-artefato.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@marsidev/react-turnstile": "1.6.2",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "@tesseract.js-data/por": "1.0.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "idb-keyval": "6.3.0",
    "input-otp": "1.5.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "read-excel-file": "9.3.12",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "pg": "8.23.1",
    "secretlint": "13.0.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "worker-f": "0.1.20",
    "@napi-rs/canvas": "1.0.11"
  }
}
