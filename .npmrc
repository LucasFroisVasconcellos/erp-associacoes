# Segurança da cadeia de suprimentos (guia do projeto)
# - só aceita versões publicadas há pelo menos 7 dias (npm >= 11.10)
# - não executa scripts de instalação de pacotes
# - grava versões exatas no package.json
min-release-age=7
ignore-scripts=true
save-exact=true
audit=true
fund=false
engine-strict=true
