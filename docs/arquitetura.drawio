<mxfile host="Electron" type="device"><diagram id="pagina-1" name="1. Visão geral"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Sistema de Gestão Integrada — arquitetura&lt;/b&gt;&lt;br&gt;Quem decide é o servidor (RLS + funções do banco). Na dúvida, nega." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="g2" value="Pessoas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="620" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Diretoria&lt;/b&gt;&lt;br&gt;celular ou computador&lt;br&gt;senha + código do autenticador" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Visitante sem login&lt;/b&gt;&lt;br&gt;só a página de transparência e a política de privacidade" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="190" height="90" as="geometry"/></mxCell><mxCell id="g5" value="Navegador" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="310" height="620" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Site React (SPA, rotas #)&lt;/b&gt;&lt;br&gt;Guardas de rota só escondem telas: não são controle de acesso" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="270" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Leitura no aparelho&lt;/b&gt;&lt;br&gt;OCR do cupom, QR da NFC-e, boleto, OFX/CSV, XML da NF-e, planilhas. Foto reduzida e sem GPS. Tudo é só sugestão: o servidor valida de novo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Sessão&lt;/b&gt;&lt;br&gt;sessionStorage; com &quot;manter conectado&quot;, localStorage por até 30 dias (ADR 0017)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="270" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Rascunhos sem internet&lt;/b&gt;&lt;br&gt;IndexedDB, separados por usuário, apagados ao sair" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="270" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Widget do CAPTCHA&lt;/b&gt;&lt;br&gt;só na tela &quot;Pedir acesso&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="540" width="270" height="60" as="geometry"/></mxCell><mxCell id="g11" value="Cloudflare" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="300" height="160" as="geometry"/></mxCell><mxCell id="g12" value="Cloudflare" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="300" height="160" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Cloudflare Pages&lt;/b&gt;&lt;br&gt;site estático do ramo &lt;i&gt;producao&lt;/i&gt;&lt;br&gt;_headers: CSP, HSTS, frame-ancestors, sem source map" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="260" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Cloudflare Turnstile&lt;/b&gt;&lt;br&gt;CAPTCHA. O token é conferido no servidor (siteverify), com hostname" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="260" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;GitHub (privado)&lt;/b&gt;&lt;br&gt;main → CI verde → fast-forward para &lt;i&gt;producao&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="g16" value="Supabase (São Paulo, plano Free) — limite de confiança: o servidor decide" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="560" height="830" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;senha + TOTP obrigatório&lt;br&gt;JWT com aal2 · convites e troca de senha" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="250" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Data API (PostgREST)&lt;/b&gt;&lt;br&gt;só RPCs public.* (SECURITY INVOKER)&lt;br&gt;sem INSERT/UPDATE/DELETE direto" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="250" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Edge Functions&lt;/b&gt;&lt;br&gt;• convidar (JWT)&lt;br&gt;• enviar-arquivo (JWT)&lt;br&gt;• pedir-acesso (público + CAPTCHA)&lt;br&gt;• limpar-arquivos (chave &quot;limpeza&quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="250" width="280" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;enviar-emails&lt;/b&gt;&lt;br&gt;desligada (decisão: sem e-mails de aviso)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;fontColor=#999999;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1330" y="250" width="170" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;RLS em todas as tabelas + política RESTRICTIVE que exige aal2&lt;br&gt;regras em private.* (SECURITY DEFINER, search_path vazio)&lt;br&gt;dinheiro imutável depois de fechado · trilha de auditoria" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="330" height="140" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Storage (buckets privados)&lt;/b&gt;&lt;br&gt;comprovantes · contador · pessoas · saude · institucional · captacao&lt;br&gt;leitura só por URL assinada&lt;br&gt;gravação só pela Edge Function" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="410" width="170" height="180" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;pg_cron + pg_net (rotinas diárias)&lt;/b&gt;&lt;br&gt;06:17 retenção (LGPD) · 06:37 limpar arquivos · 09:07 organização&lt;br&gt;10:13 pede o salário mínimo · 10:23 grava" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="620" width="520" height="90" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;transparencia_publica()&lt;/b&gt;&lt;br&gt;única RPC liberada sem login: só números agregados já publicados" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="750" width="330" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Banco Central (API SGS)&lt;/b&gt;&lt;br&gt;série 1619 — salário mínimo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1560" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Caixa de e-mail&lt;/b&gt;&lt;br&gt;convite e senha (modelo padrão do Supabase, em inglês)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1560" y="130" width="230" height="80" as="geometry"/></mxCell><mxCell id="e27" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="baixa o site" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="publica em ~2 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="login + código TOTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="132"/><mxPoint x="610" y="100"/><mxPoint x="950" y="100"/><mxPoint x="950" y="142"/></Array></mxGeometry></mxCell><mxCell id="e31" value="RPCs com o JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="95"/><mxPoint x="1375" y="95"/></Array></mxGeometry></mxCell><mxCell id="e32" value="arquivos, convite, pedido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="188"/><mxPoint x="605" y="232"/><mxPoint x="940" y="232"/><mxPoint x="940" y="286"/></Array></mxGeometry></mxCell><mxCell id="e33" value="chama private.*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.93;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="1º autoriza como o usuário&lt;br&gt;2º registra (service role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="grava com nome aleatório" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1364" y="352"/></Array></mxGeometry></mxCell><mxCell id="e36" value="lê por URL assinada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="196"/><mxPoint x="612" y="252"/><mxPoint x="930" y="252"/><mxPoint x="930" y="595"/><mxPoint x="1320" y="595"/><mxPoint x="1320" y="572"/></Array></mxGeometry></mxCell><mxCell id="e37" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="siteverify (pedir-acesso)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="352"/><mxPoint x="950" y="565"/></Array></mxGeometry></mxCell><mxCell id="e39" value="e-mail do convite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1105" y="108"/><mxPoint x="1540" y="108"/><mxPoint x="1540" y="170"/></Array></mxGeometry></mxCell><mxCell id="e40" value="GET (pg_net)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="chama limpar-arquivos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="966" y="647"/><mxPoint x="966" y="340"/></Array></mxGeometry></mxCell><mxCell id="e42" value="#/transparencia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="525"/><mxPoint x="612" y="785"/></Array></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;seta cheia = chamada · tracejada = leitura ou chamada agendada&lt;br&gt;cinza tracejado = existe mas está desligado · vermelho = acessível sem login&lt;br&gt;Segredos (TURNSTILE_SECRET_KEY, APP_ORIGIN, service role) só no Supabase. No site, só a chave pública do CAPTCHA." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="580" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-2" name="2. Fluxo de upload"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Fluxo de upload de arquivo (comprovante, documento, arquivo do contador)&lt;/b&gt;&lt;br&gt;O navegador só ajuda. Tudo que importa é conferido de novo na Edge Function e no banco, nesta ordem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Navegador" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g3" value="Edge Function enviar-arquivo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g4" value="Postgres (RPCs)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g5" value="Storage (bucket privado)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1.&lt;/b&gt; Confere o tipo pelos bytes e o tamanho; foto reduzida e regravada sem GPS (EXIF). Só pré-checagem: não é segurança" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2.&lt;/b&gt; Recebe o POST com o JWT. Sem sessão válida: 401" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="215" width="250" height="70" as="geometry"/></mxCell><mxCell id="e8" value="POST multipart + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;3.&lt;/b&gt; Confere método, tamanho (PDF até 50 MB, outros até 10 MB), só campos permitidos e destino de uma lista fixa" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="310" width="250" height="70" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;4.&lt;/b&gt; Confere o tipo REAL pelos bytes (foto, PDF, XML de nota…). Executável, HTML ou SVG disfarçado: recusa" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="405" width="250" height="70" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;5.&lt;/b&gt; autorizar_*() COM A SESSÃO DO USUÁRIO: RLS, aal2 (2FA), permissão no módulo, alcance e limite de uso" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="250" height="70" as="geometry"/></mxCell><mxCell id="e14" value="sessão do usuário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;6.&lt;/b&gt; Recusou? Responde 403 / 404 / 422 / 429 e para aqui (fail closed). Nada é gravado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="595" width="250" height="70" as="geometry"/></mxCell><mxCell id="e16" value="recusou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;7.&lt;/b&gt; Autorizado: grava com nome aleatório, no bucket da lista fixa, sem sobrescrever (service role)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="690" width="250" height="70" as="geometry"/></mxCell><mxCell id="e18" value="autorizou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;8.&lt;/b&gt; registrar_*() (service role): guarda caminho, origem, QR/boleto e o SHA-256 → aviso de comprovante repetido" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="785" width="250" height="70" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;9.&lt;/b&gt; Se o registro falhar, a função apaga o arquivo que acabou de gravar (não fica arquivo órfão)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="880" width="250" height="70" as="geometry"/></mxCell><mxCell id="e22" value="falhou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;10.&lt;/b&gt; Recebe a resposta. Para ver o arquivo depois: URL assinada, só se a RLS deixar ver o registro" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="250" height="70" as="geometry"/></mxCell><mxCell id="e24" value="deu certo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pagina-3" name="3. Fluxo de convite"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Fluxo de convite para a diretoria&lt;/b&gt;&lt;br&gt;O banco decide se o convite pode existir. Só depois o e-mail sai, com a chave de serviço, dentro do Supabase." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Administrador (navegador)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g3" value="Edge Function convidar" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g4" value="Postgres (RPCs)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g5" value="Supabase Auth" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="g6" value="Convidado (e-mail e navegador)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;opacity=45;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="290" height="1050" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1.&lt;/b&gt; Preenche nome, e-mail, cargo do estatuto e permissões (ou o modelo do cargo)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2.&lt;/b&gt; Recebe o POST com o JWT do administrador. Corpo até 16 KB, JSON estrito: campo extra é recusado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="215" width="250" height="70" as="geometry"/></mxCell><mxCell id="e9" value="POST + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;3.&lt;/b&gt; registrar_convite() com a sessão do administrador: é administrador? 2FA recente? limite de uso? e-mail já é membro?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="250" height="70" as="geometry"/></mxCell><mxCell id="e11" value="sessão do admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;4.&lt;/b&gt; Recusou? 403 / 409 / 429 e para aqui. Nenhum e-mail sai" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="405" width="250" height="70" as="geometry"/></mxCell><mxCell id="e13" value="recusou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;5.&lt;/b&gt; A função pede ao Auth o convite (inviteUserByEmail, service role), com volta para APP_ORIGIN/#/entrar/link. O Auth envia o e-mail" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="500" width="250" height="70" as="geometry"/></mxCell><mxCell id="e15" value="autorizou" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;6.&lt;/b&gt; Recebe o e-mail (modelo padrão do Supabase, em inglês) e toca no link" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="595" width="250" height="70" as="geometry"/></mxCell><mxCell id="e17" value="e-mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;7.&lt;/b&gt; Confere o link (uso único, com prazo) e devolve para o site" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="690" width="250" height="70" as="geometry"/></mxCell><mxCell id="e19" value="toca no link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;8.&lt;/b&gt; Tela &quot;Crie sua senha&quot; → cadastra o autenticador (2FA obrigatório)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="785" width="250" height="70" as="geometry"/></mxCell><mxCell id="e21" value="volta ao site" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;9.&lt;/b&gt; aceitar_convite() liga a conta ao convite do próprio e-mail. Convite cancelado: &quot;Esse convite não vale mais&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="880" width="250" height="70" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;10.&lt;/b&gt; O novo membro aparece em Acessos com o cargo. Tudo fica na trilha de auditoria" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="250" height="70" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
